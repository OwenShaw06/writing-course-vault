views:
  - type: table
    name: View
    filters:
      and:
        - type == "lesson"
    order:
      - file.name
      - status
      - started
      - finished
      - lesson
    sort:
      - property: file.name
        direction: DESC
  - type: table
    name: In Progress
    filters:
      and:
        - status == "in progress"
